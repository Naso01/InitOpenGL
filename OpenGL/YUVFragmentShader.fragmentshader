#version 330

in vec3 retColor;
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D sampler1;
uniform sampler2D sampler2;

uniform float YChannel;
uniform float UChannel;
uniform float VChannel;

void main()
{

   mat3 yuvMatrix = mat3( //Convert RGB to YUV
		0.299f, 0.587f, 0.114f,
		-0.14713f, -0.28886f, 0.436f,
		0.615f, -0.51499f, -0.10001f
	);

    mat3 rgbMatrix = mat3( //Convert YUV to RGB
		1, 0, 1.13983f,
		1, -0.39465f, -0.58060f,
		1, 2.03211f, 0
	);

    vec4 texColor = mix(texture(sampler1, retTexCoord), texture(sampler2, retTexCoord), 0.3) * vec4(retColor, 1.0f);

    vec3 FragColorRGB = vec3(texColor.r, texColor.g, texColor.b);
    vec3 FragColorYUV = FragColorRGB * yuvMatrix;
	vec3 ResultColorYUV = vec3(FragColorYUV.r * (YChannel/100), FragColorYUV.g * (UChannel/100), FragColorYUV.b * (VChannel/100));

    vec3 ResultColorRGB = ResultColorYUV * rgbMatrix;

   FragColor = vec4(ResultColorRGB, 1.0f);
}