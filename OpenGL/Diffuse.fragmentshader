#version 330

in vec3 retNormal; // MUST use same name as out variable used by vertex shader
in vec2 retTexCoord;

out vec4 FragColor;
  
uniform vec3 AmbientLight;
uniform vec3 DiffuseColor;
uniform sampler2D sampler1;
uniform sampler2D sampler2;

// uniform int RenderRedChannel;
// uniform int RenderGreenChannel;
// uniform int RenderBlueChannel;

void main()
{
	vec4 color = vec4(DiffuseColor, 1.0f) * texture(sampler1, retTexCoord);
	FragColor = color * vec4(AmbientLight, 1.0f);

