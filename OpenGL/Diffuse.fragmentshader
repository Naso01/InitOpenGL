#version 330

in vec3 retNormal; // MUST use same name as out variable used by vertex shader
in vec2 retTexCoord;
in vec3 retFragPos;
in vec3 retViewDirection;

out vec4 FragColor;

struct Material{

	float specularStrength;
	sampler2D diffuseTexture;
	sampler2D specularTexture;
};

struct Light{

	vec3 position;
	vec3 color;
	vec3 ambientColor;
	vec3 diffuseColor;
	vec3 specularColor;

    float constant;
    float linear;
    float quadratic;

    vec3 direction;
    float coneAngle;
    float falloff;
};

uniform Material material;
#define NR_LIGHTS 4
uniform Light lights[NR_LIGHTS];

void main()
{
    vec4 finalColor = vec4(0);
    for(int i = 0; i < NR_LIGHTS; i++){
    
        vec3 lightDir = normalize(lights[i].position - retFragPos); // Normalize, for correct dot product result
        float a = cos(lights[i].coneAngle);
        float d = dot(normalize(lights[i].direction), - lightDir);
        if(a < d) // Visible in cone?
        {
            float lambertianStrength = dot(lightDir, retNormal); // Add lambertian lighting
            vec3 refl = reflect(-lightDir, retNormal);
            float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength); //Specular component
            float distance = length(lights[i].position - retFragPos);
            float att = 1.0f / (lights[i].constant + lights[i].linear * distance + lights[i].quadratic * (distance * distance)); // Point falloff
            att *= 1 - pow(clamp(a / d, 0.0f, 1.0f), lights[i].falloff); // Sportlight falloff

            vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * lights[i].ambientColor;
            vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * lights[i].diffuseColor * att;
            vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * lights[i].specularColor * att;

            FragColor = vec4(ambient + lambertian + specular, 1.0f); // Calculate final color
         }
   
        else
        {
            vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * lights[i].ambientColor / NR_LIGHTS;
            finalColor += vec4(ambient, 1.0f); // Calculate final color
        }
    }
    FragColor = finalColor;
}
