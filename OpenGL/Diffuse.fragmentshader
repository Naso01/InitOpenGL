#version 330

in vec3 retNormal;
in vec2 retTexCoord;
in vec3 retFragPos;
in vec3 retViewDirection;

out vec4 FragColor;

struct Material{
    float specularStrength;
    sampler2D diffuseTexture;
    sampler2D specularTexture;
};

struct Light{
    vec3 position;
    vec3 color;
    vec3 ambientColor;
    vec3 diffuseColor;
    vec3 specularColor;
};

uniform bool ColorByPosition;

uniform Material material;
#define NR_LIGHTS 1
uniform Light light[NR_LIGHTS];

void main()
{
    vec4 finalColor = vec4(0);

    vec3 diffuseTex = texture(material.diffuseTexture, retTexCoord).rgb;

    if (ColorByPosition)
    {
        vec3 posColor = abs(retFragPos);
       posColor = clamp(posColor, 0.0, 1.0);
        diffuseTex *= posColor;
    }

    for(int i = 0; i < NR_LIGHTS; i++)
    { 
    
        vec3 ambient = diffuseTex * light[i].ambientColor / NR_LIGHTS;

        if(!ColorByPosition)
        {
            vec3 lightDir = normalize(light[i].position - retFragPos);
            float lambertianStrength = dot(lightDir, retNormal);
            vec3 refl = reflect(-lightDir, retNormal);
            float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f),
                                         material.specularStrength);

            // use tinted diffuseTex instead of sampling again
       
            vec3 lambertian = lambertianStrength * diffuseTex * light[i].diffuseColor;

            // specular remains unaffected (you can tint it too if you want)
            vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).rgb * light[i].specularColor;

            finalColor += vec4(ambient + lambertian + specular, 1.0f);
        }
        else
        {
            finalColor += vec4(ambient, 1.0f);
        }
    }

    FragColor = finalColor;
}
