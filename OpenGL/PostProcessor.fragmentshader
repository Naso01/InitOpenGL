#version 330
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D ScreenTexture;

void main(){

	//Regular post processing
	//vec3 col = texture(ScreenTexture, retTexCoord).rgb;
	//FragColor = vec4(col, 1.0);

	//Inversion
	//FragColor = vec4(vec3(1.0 - texture(ScreenTexture, retTexCoord)), 1.0);

	// "Artificial" GrayScale
	vec3 col = texture(ScreenTexture, retTexCoord).rgb;
	float average = (col.r + col.g + col.b) / 3;
	FragColor = vec4(average, average, average, 1.0);
}