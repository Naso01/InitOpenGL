#version 330

in vec3 vertices; // Value set from application to this attribute
in vec3 normals; // Input normals from application

uniform vec3 CameraPosition;
uniform mat4 World;
uniform mat4 WVP; // World-View-Projection matrix from application

out vec3 retNormal; // output a normal to the fragment shader
out vec3 retFragPos;
out vec3 retViewDirection;

void main()
{
	gl_Position = WVP * vec4(vertices, 1.0); // Transform the model to screen projection
	retNormal = normalize(mat3(transpose(inverse(World))) * normals);
	retFragPos = vec3(World * vec4(vertices, 1.0f));
	retViewDirection = normalize(CameraPosition - retFragPos);
}